      "locked": false,
      "text": "6 DECODER + RESAMPLER\nUse reader.rs, resample.rs.\nMake 48 kHz stereo float.\nFix rate and channels.\nSend clean audio up.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baselineIndex": 0
