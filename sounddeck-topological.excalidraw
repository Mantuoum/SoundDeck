      "updated": 1,
      "link": null,
      "locked": false,
      "text": "5 POLICY playback/policy.rs\nSay RAM or disk.\nOne sound: max 30 sec.\nAll RAM: max 32 MB.\nAll RAM: max 16 sounds.\nWhole app: max 125 MB.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baselineIndex": 0
    },
