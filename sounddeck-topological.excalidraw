      "updated": 1,
      "link": null,
      "locked": false,
      "text": "STORE config/\nAll files in one folder.\n/themes/<id>.json is theme.\nStem is id. Name is display.\nGraphite.json IS the seed.\nSave tmp. Keep .bak copy.\nCorrupt stays as .corrupt.\nNever copy or delete audio.\nHold read lock on files.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baselineIndex": 0
    },
