      "text": "7 LOADER thread\nRead whole file to RAM.\nMake 48 kHz stereo float.\nTell Playback when done.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
